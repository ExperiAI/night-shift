    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 86400,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "5lwmeni2xhisnhbr.public.blob.vercel-storage.com"
      }
    ]
  }
}